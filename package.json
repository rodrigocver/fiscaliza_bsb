{
  "name": "fiscaliza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ingest": "tsx scripts/ingest.ts",
    "format": "prettier --write src scripts tests",
    "resumo-mensal": "tsx scripts/resumo-mensal.ts",
    "db:up": "docker compose up -d",
    "test:integracao": "vitest run --config vitest.integracao.config.mts",
    "verificar": "npm run lint && npm run typecheck && npm test && npm run test:integracao",
    "conferir:cache": "node scripts/conferir-cache.mjs",
    "e2e:preparar": "tsx tests/e2e/preparar-banco.ts",
    "test:e2e": "npm run e2e:preparar && DATABASE_URL=${DATABASE_URL_TESTE:-postgres://fiscaliza:fiscaliza@localhost:5432/fiscaliza_teste} npm run build && playwright test",
    "exemplo": "tsx scripts/exemplo.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "marked": "^18.1.1",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "description": "Acompanhe presença, votações, projetos e gastos de deputados federais e senadores com dados públicos oficiais."
}
